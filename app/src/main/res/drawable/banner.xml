<?xml version="1.0" encoding="utf-8"?>
<!-- Banner de 320×180 (16:9): a cabra da GoatTV sobre azul-noite. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size android:width="320dp" android:height="180dp" />
            <gradient
                android:angle="315"
                android:endColor="#FF1E1B4B"
                android:startColor="#FF0B1020" />
        </shape>
    </item>
    <item
        android:width="150dp"
        android:height="114dp"
        android:gravity="center">
        <bitmap android:src="@drawable/brand_mark" />
    </item>
</layer-list>
