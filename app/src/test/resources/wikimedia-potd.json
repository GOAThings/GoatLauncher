i><a href=\"https://www.wikidata.org/wiki/Q54800218\" class=\"extiw\" title=\"d:Q54800218\"><span title=\"Scottish wildlife photographer\">Charles J. Sharp</span></a></bdi>","source":"commons-desc-page"},"LicenseShortName":{"value":"CC BY-SA 4.0","source":"commons-desc-page","hidden":""}},"mime":"image/jpeg"}]},{"pageid":133498612,"ns":6,"title":"File:Pez ballesta ondulado (Balistapus undulatus), mar Rojo, Egipto, 2023-04-15, DD 45.jpg","imagerepository":"local","imageinfo":[{"size":11810264,"width":5174,"height":3449,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/7a/Pez_ballesta_ondulado_%28Balistapus_undulatus%29%2C_mar_Rojo%2C_Egipto%2C_2023-04-15%2C_DD_45.jpg/3840px-Pez_ballesta_ondulado_%28Balistapus_undulatus%29%2C_mar_Rojo%2C_Egipto%2C_2023-04-15%2C_DD_45.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":3840,"thumbheight":2560,"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/7a/Pez_ballesta_ondulado_%28Balistapus_undulatus%29%2C_mar_Rojo%2C_Egipto%2C_2023-04-15%2C_DD_45.jpg/3840px-Pez_ballesta_ondulado_%28Balistapus_undulatus%29%2C_mar_Rojo%2C_Egipto%2C_2023-04-15%2C_DD_45.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":3840,"height":2560},"url":"https://upload.wikimedia.org/wikipedia/commons/7/7a/Pez_ballesta_ondulado_%28Balistapus_undulatus%29%2C_mar_Rojo%2C_Egipto%2C_2023-04-15%2C_DD_45.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Pez_ballesta_ondulado_(Balistapus_undulatus),_mar_Rojo,_Egipto,_2023-04-15,_DD_45.jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=133498612","extmetadata":{"ObjectName":{"value":"Pez ballesta ondulado (Balistapus undulatus), mar Rojo, Egipto, 2023-04-15, DD 45","source":"mediawiki-metadata"},"ImageDescription":{"value":"<a href=\"https://en.wikipedia.org/wiki/Orange-lined_triggerfish\" class=\"extiw\" title=\"en:Orange-lined triggerfish\">Orange-lined triggerfish</a> (<i>Balistapus undulatus</i>), <a href=\"https://en.wikipedia.org/wiki/Red_Sea\" class=\"extiw\" title=\"en:Red Sea\">Red Sea</a>, Egypt. This demersal triggerfish has a maximum body size of about 30 centimetres (12 in) and is found across the Indo-western Pacific East Africa, Red Sea and Japan, typically in coral reefs ecosystems, coral lagoons, and external reef slopes within this area. Within coral reefs, the orange-lined triggerfish are more versatile than other triggerfish species and can be found at depths up to 50 metres (160 ft), although studies have found that they prefer depths of 2 to 8 metres (6 ft 7 in to 26 ft 3 in). It's an omnivorous feeder that can, because of its strong and heavy teeth, tackle a variety of benthic prey like cnidarians, molluscs, ctenophores, crustaceans, other fish, algae, and echinoderms. This species in particular, given its broad diet and distribution, is a crucial component in coral reef ecosystems through top-down control and especially through consumption of sea-urchin.","source":"commons-desc-page"},"Artist":{"value":"<bdi><a href=\"https://www.wikidata.org/wiki/Q28147777\" class=\"extiw\" title=\"d:Q28147777\"><span title=\"Spanish photographer\">Diego Delso</span></a></bdi>","source":"commons-desc-page"},"LicenseShortName":{"value":"CC BY-SA 4.0","source":"commons-desc-page","hidden":""}},"mime":"image/jpeg"}]},{"pageid":143528237,"ns":6,"title":"File:Common wombat (Vombatus ursinus tasmaniensis) juvenile Maria Island.jpg","imagerepository":"local","imageinfo":[{"size":9496842,"width":4012,"height":3491,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/83/Common_wombat_%28Vombatus_ursinus_tasmaniensis%29_juvenile_Maria_Island.jpg/3840px-Common_wombat_%28Vombatus_ursinus_tasmaniensis%29_juvenile_Maria_Island.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content